// =============================================================================
// nipt_mngs_qc — конфигурация
// Все QC-пороги — параметры: калибруются на реальных данных без правки кода.
// =============================================================================

params {
    // ---- вход ----
    input       = null        // samplesheet CSV
    mode        = 'bam'       // 'bam' (от DEHOST/HOST bam NIPD) | 'fastq' (полный путь)
    host_index  = null        // префикс HISAT2-индекса человека (mode=fastq)
    db_full     = null        // Kraken2/Bracken БД полного профилирования
    db_patho    = null        // Kraken2/Bracken БД патогенов (EukPathDB)
    outdir      = 'results'

    // ---- параметры стадий ----
    fastp_min_len      = 35
    kraken_confidence  = 0.15
    bracken_min_reads  = 10    // минимум прочтений вида для отчёта
    bracken_read_len   = 150   // длина прочтения для bracken-build БД
    enrichment_fold    = 10    // обогащение dehost/host для статуса enriched

    // ---- QC-пороги (дефолты под реальный low-pass НИПТ; см. QC_checklist.md) ----
    min_input_pairs        = 5000000  // достаточность входа, пар
    min_q30                = 0.80     // Q30 сырых прочтений
    min_trim_survival      = 0.90     // доля пар после тримминга
    host_frac_min          = 0.95     // ниже — аномалия wet-lab
    min_nonhost_reads      = 50000    // edge case «нулевой микробиом»
    max_dehost_human_frac  = 0.05     // утечка human в dehost = сбой dehost
    min_classified_frac    = 0.0001   // санити: классифицируемая доля > 0
    max_consistency_dev    = 0.01     // |dehost+host - trimmed| / trimmed

    // ---- ресурсы ----
    kraken_mem = '60 GB'     // Standard-БД Kraken2 держится в RAM; для toy — меньше

    // ---- storage hygiene ----
    work_cleanup = false     // true в проде: затирать work/ после успешного рана
}

cleanup = params.work_cleanup

process {
    cpus   = 4
    memory = '8 GB'

    withLabel: 'process_low'    { cpus = 2; memory = '4 GB' }
    withLabel: 'process_medium' { cpus = 8; memory = '16 GB' }
    withLabel: 'process_kraken' {
        cpus   = 8
        memory = params.kraken_mem
        // Kraken2 падает по OOM, если БД не влезла в RAM — даём второй шанс с x1.5
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries    = 1
        memory        = { params.kraken_mem * (1 + 0.5 * task.attempt) }
    }
}

profiles {
    // локальный запуск: инструменты на PATH
    standard { }

    // conda-окружение (собирается из environment.yml)
    conda {
        process.conda = "${projectDir}/environment.yml"
        conda.enabled = true
    }

    // toy-data smoke test: ослабленные пороги и маленькая RAM
    // (профиль рассчитан на ноутбук ~4 GB RAM; на сервере можно не менять)
    test {
        params.kraken_mem          = '2 GB'
        params.min_input_pairs     = 10000
        params.min_q30             = 0.50
        params.min_trim_survival   = 0.50
        params.host_frac_min       = 0.80
        params.min_nonhost_reads   = 500
        params.max_dehost_human_frac = 0.05
        params.min_classified_frac = 0.0001
        params.bracken_read_len    = 150

        // Ресурсы под ноутбук ~4 GB RAM. ВАЖНО: переопределять нужно сами
        // withLabel-селекторы — они специфичнее generic process.* и перебивают
        // его даже из профиля, поэтому одного process.memory = '2 GB' мало.
        process {
            cpus   = 2
            memory = '2 GB'
            withLabel: 'process_low'    { cpus = 2; memory = '2 GB' }
            withLabel: 'process_medium' { cpus = 2; memory = '2 GB' }
            withLabel: 'process_kraken' { cpus = 2; memory = '2 GB' }
        }
    }
}

manifest {
    name        = 'nipt_mngs_qc'
    description = 'Metagenomic adjunct on top of NIPT data with per-sample QC gate'
    version     = '1.0.0'
}
