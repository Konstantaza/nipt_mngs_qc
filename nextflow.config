// =============================================================================
// nipt_mngs_qc — конфигурация
// Все QC-пороги — параметры: калибруются на реальных данных без правки кода.
// =============================================================================

params {
    // ---- вход ----
    input       = null        // samplesheet CSV
    mode        = 'bam'       // 'bam' (от DEHOST/HOST bam NIPD) | 'fastq' (полный путь)
    host_index  = null        // префикс HISAT2-индекса человека (mode=fastq)
    dbsheet     = null        // dbsheet CSV: db_id,annotator,path,role (v1.4.0; заменяет db_full/db_patho)
    fractions   = 'dehost,host'  // фракции в аннотацию (v1.5.0); 'dehost,host,all' добавляет ветку all (все прочтения без dehost)
    target_panel = null       // опц. файл таргет-панели (taxid или имена, по одному на строку); без него позитивность не оценивается
    outdir      = 'results'
    publish_validation_artifacts = false // opt-in FASTQ/BAM for in-silico GT audit

    // ---- параметры стадий ----
    fastp_min_len      = 35
    kraken_confidence  = 0.15
    bracken_min_reads  = 10    // порог -t Bracken: минимум кладных прочтений вида для отчёта
    bracken_read_len   = 150   // длина прочтения для bracken-build БД
    // ---- comparison model v2 (сравнение профилей фракций на profile v2) ----
    compare_pairs         = 'dehost:host'  // пары фракций A:B через запятую; 'all' = синтез dehost+host; dehost:host обязательна
    compare_min_reads     = 10   // присутствие таксона в фракции A (dehost)
    compare_host_min_reads = 10  // присутствие таксона в фракции B (отдельный абсолютный порог host)
    enrichment_fold    = 10    // минимальное RPM-обогащение A/B для флага enriched

    // ---- QC-пороги (дефолты под реальный low-pass НИПТ; см. QC_checklist.md) ----
    min_input_pairs        = 5000000  // достаточность входа, пар
    min_q30                = 0.80     // Q30 сырых прочтений
    min_trim_survival      = 0.90     // доля пар после тримминга
    host_frac_min          = 0.95     // ниже — аномалия wet-lab
    min_nonhost_reads      = 50000    // edge case «нулевой микробиом»
    max_dehost_human_frac  = 0.05     // утечка human в dehost = сбой dehost
    min_classified_frac    = 0.0001   // санити: классифицируемая доля > 0
    max_consistency_dev    = 0.01     // |dehost+host+half - trimmed| / trimmed (v1.5.0: точная партиция DEHOST)

    // ---- ресурсы ----
    kraken_mem = '60 GB'     // Standard-БД Kraken2 держится в RAM; для toy — меньше

    // ---- контейнеры (NIPT-7, v1.8.0) ----
    // All-in-one образ (Dockerfile в корне, собирается из environment.yml) для
    // мульти-инструментных процессов (DEHOST, BAM2FASTA, ANNOTATE_KRAKEN2_BRACKEN):
    // готовых mulled-образов с точными комбинациями версий на quay.io нет.
    // Одно-инструментные процессы тянут точные biocontainers-образы напрямую
    // (см. директивы container в modules/local/). Одна точка бампа версии — здесь.
    pipeline_image = 'nipt_mngs_qc:1.10.0'

    // ---- storage hygiene ----
    work_cleanup = false     // true в проде: затирать work/ после успешного рана
}

cleanup = params.work_cleanup

process {
    cpus   = 4
    memory = '8 GB'

    // NIPT-7 (v1.8.0): жёсткий потолок ресурсов на задачу — защита от
    // runaway-значений и от ретрая сверх физической RAM машины. Kraken2 с
    // ретраем не превысит 2 x kraken_mem. Вычисляется один раз при чтении
    // конфига (с дефолтным/CLI-значением kraken_mem) — это потолок, а не
    // запрос, поэтому ослабленный kraken_mem в профиле test его не ломает.
    resourceLimits = [cpus: 16, memory: (params.kraken_mem as MemoryUnit) * 2, time: 24.h]

    withLabel: 'process_low'    { cpus = 2; memory = '4 GB' }
    withLabel: 'process_medium' { cpus = 8; memory = '16 GB' }
    withLabel: 'process_kraken' {
        cpus = 8
        // Kraken2 падает по OOM (exit 137), если БД не влезла в RAM — ретрай
        // с удвоенной памятью. NIPT-7: params.kraken_mem — СТРОКА ('60 GB'),
        // поэтому перед умножением кастуем в MemoryUnit; иначе Groovy повторял
        // строку и на второй попытке получался невалидный '60 GB60 GB'
        // (баг v1.7.0: memory задавалась дважды, второе замыкание умножало
        // строку на число).
        memory        = { (params.kraken_mem as MemoryUnit) * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries    = 1
    }
}

profiles {
    // локальный запуск: инструменты на PATH
    standard { }

    // conda: per-process окружения из директив conda в модулях (NIPT-7, v1.8.0;
    // раньше — одно монолитное process.conda = environment.yml на все процессы).
    // Nextflow собирает по одному env на уникальную директиву.
    conda {
        conda.enabled = true
    }

    // docker: per-process контейнеры из директив container в модулях
    // (NIPT-7, v1.8.0; раньше — один process.container на все процессы).
    // Одно-инструментные процессы тянут образы с quay.io/biocontainers;
    // три мульти-инструментальных используют params.pipeline_image — его нужно
    // собрать заранее (docker build -t nipt_mngs_qc:1.10.0 .), это делает
    // harness test/run_smoke.sh на чистой машине:
    //   nextflow run main.nf -profile test,docker
    docker {
        docker.enabled        = true
        docker.userEmulation  = true   // файлы work/ принадлежат пользователю, не root
    }

    // toy-data smoke test: ослабленные пороги и маленькая RAM
    // (профиль рассчитан на ноутбук ~4 GB RAM; на сервере можно не менять).
    // v1.7.0: профиль самодостаточен — входы toy-набора заданы внутри
    // (input подбирается под params.mode, т.к. CLI-параметры видны при
    // вычислении конфига); любой из них можно переопределить с CLI.
    test {
        params.input = params.mode == 'fastq' ?
            "${projectDir}/test/toy/samplesheet_fastq.csv" :
            "${projectDir}/test/toy/samplesheet_bam.csv"
        params.dbsheet      = "${projectDir}/test/toy/dbsheet.csv"
        params.host_index   = "${projectDir}/test/toy/host_index/human"
        params.target_panel = "${projectDir}/test/toy/target_panel.txt"

        params.kraken_mem          = '2 GB'
        params.min_input_pairs     = 10000
        params.min_q30             = 0.50
        params.min_trim_survival   = 0.50
        params.host_frac_min       = 0.80
        params.min_nonhost_reads   = 500
        params.max_dehost_human_frac = 0.05
        params.min_classified_frac = 0.0001
        params.bracken_read_len    = 150

        // Ресурсы под ноутбук ~4 GB RAM. ВАЖНО: переопределять нужно сами
        // withLabel-селекторы — они специфичнее generic process.* и перебивают
        // его даже из профиля, поэтому одного process.memory = '2 GB' мало.
        // NIPT-7: у process_kraken НЕ переопределяем memory — статическое
        // значение затёрло бы базовое замыкание с ретраем; память kraken в
        // test-профиле задаёт params.kraken_mem = '2 GB' (попытка 1: 2 GB,
        // попытка 2: 4 GB), а cpus сужаем до 2.
        process {
            cpus   = 2
            memory = '2 GB'
            withLabel: 'process_low'    { cpus = 2; memory = '2 GB' }
            withLabel: 'process_medium' { cpus = 2; memory = '2 GB' }
            withLabel: 'process_kraken' { cpus = 2 }
        }
    }
}

manifest {
    name        = 'nipt_mngs_qc'
    description = 'Metagenomic adjunct on top of NIPT data with per-sample QC gate'
    version     = '1.10.0'
    // NIPT-7: минимальная проверенная версия Nextflow (жёсткое требование,
    // '!' = отказ запуска на более старых). Разработка и smoke — на 26.x.
    nextflowVersion = '!>=26.04.6'
}
