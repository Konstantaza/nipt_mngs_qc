// Software acceptance thresholds, NOT a clinical QC calibration.
params {
    min_input_pairs = 100000
    min_nonhost_reads = 1000
    host_frac_min = 0.993
    min_q30 = 0.80
    min_trim_survival = 0.90
    max_dehost_human_frac = 0.05
    min_classified_frac = 0.0001
    bracken_min_reads = 10
    compare_min_reads = 10
    compare_host_min_reads = 10
    publish_validation_artifacts = true
    kraken_mem = '2 GB'
}
process {
    cpus = 2
    memory = '2 GB'
    withLabel: process_low { cpus = 2; memory = '2 GB' }
    withLabel: process_medium { cpus = 2; memory = '2 GB' }
    withLabel: process_kraken { cpus = 2 }
}
